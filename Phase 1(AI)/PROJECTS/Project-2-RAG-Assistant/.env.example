# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Google AI Studio key. Used for embeddings (Step 6) and generation (Step 13).
GEMINI_API_KEY=your_gemini_key_here

# Cohere key. Used only for the cross-encoder reranker (Step 11).
COHERE_API_KEY=your_cohere_key_here

# Postgres + pgvector (Step 5). Matches the docker-compose.yml defaults.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb
