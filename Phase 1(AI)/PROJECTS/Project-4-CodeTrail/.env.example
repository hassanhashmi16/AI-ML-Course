# Copy this file to .env. Leave keys empty until the corresponding live stage.
# Use a GitHub token with only the read access needed for public sources.
GITHUB_TOKEN=
GEMINI_API_KEY=
# Groq generation key (console.groq.com); used when generation switches to Groq.
GROQ_API_KEY=
COHERE_API_KEY=

# Optional cloud tracing. It stays off unless deliberately enabled later.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=codetrail

# Documented model IDs checked on 16 October 2026; account access is checked
# when provider calls are introduced. Change IDs here, not throughout the code.
# Generation: Groq by default; GEN_PROVIDER=google uses GEN_MODEL + GEMINI_API_KEY.
GEN_PROVIDER=groq
GROQ_GEN_MODEL=openai/gpt-oss-120b
GEN_MODEL=gemini-3.7-flash
# Embeddings run locally (FastEmbed) by default: no key, no quota.
# EMBED_PROVIDER=google switches to GEMINI_API_KEY with the settings below.
EMBED_PROVIDER=fastembed
FASTEMBED_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
SPARSE_MODEL=Qdrant/bm25
# Reranking runs locally (fastembed) by default; "cohere" uses RERANK_MODEL
# with COHERE_API_KEY; "none" keeps retrieval order (labelled as disabled).
RERANK_PROVIDER=fastembed
FASTEMBED_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_MODEL=rerank-v4.0-fast

# Retrieve a wider set before returning the reranker's smaller evidence set.
RETRIEVE_K=20
RERANK_K=5

# Bounded collection and investigation, as defined in STEPS.md.
MAX_FILES=40
MAX_COMMITS=60
MAX_DISCUSSIONS=10
MAX_COMMENTS=20
MAX_TOOL_CALLS=12
MAX_RETRIEVAL_ROUNDS=2
MAX_ANSWER_REVISIONS=1
MAX_RUN_SECONDS=120
TOKEN_BUDGET=40000
MAX_OUTPUT_TOKENS=2048
GITHUB_TIMEOUT_SECONDS=20

# Paths default to this project's data/ and reports/ directories.
# Relative overrides are also resolved against this project, not the shell.
# DATA_DIR=data
# REPORTS_DIR=reports
