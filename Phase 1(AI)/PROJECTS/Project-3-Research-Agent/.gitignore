# Virtual environment
venv/
.venv/
env/

# Secrets. `.env.example` is the template and IS committed; real keys are not.
# The `!` line re-includes it, because `.env.*` would otherwise match it too —
# gitignore rules are order-sensitive, so the negation must come last.
.env
.env.*
!.env.example

# Python bytecode
__pycache__/
*.py[cod]

# Runtime state: checkpoints + memory. Regenerated by running the agent, so it
# does not belong in git (and can get large).
data/agent.db

# Generated briefs are output, not source.
briefs/
