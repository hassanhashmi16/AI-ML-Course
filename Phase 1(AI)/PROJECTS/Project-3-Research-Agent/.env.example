# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Google AI Studio key. Used for the agent's model calls and tool calling.
GEMINI_API_KEY=

# Optional. Leave blank to use free, keyless DuckDuckGo search.
# Set it in `.env` to switch the agent over to Tavily (better result quality).
TAVILY_API_KEY=

# Optional. Overrides the default model in config.py. Useful when a model is
# overloaded (503 "high demand") or your key cannot access the default.
# On 2026-10-14 the 3.5-3.8 flash models were 503ing and this one answered:
# GEN_MODEL=gemini-3.1-flash-lite
